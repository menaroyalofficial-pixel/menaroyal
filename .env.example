# MENA ROYAL settings. Copy to .env.local for your laptop; put the real values in Vercel.
# Never commit real values.

# --- Supabase (Supabase dashboard -> Project Settings -> API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. "service_role" key. Never in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana (devnet only) ---
SOLANA_CLUSTER=devnet
# RPC for the server. Leave empty to use Helius (if HELIUS_API_KEY is set) or the public devnet RPC.
SOLANA_RPC_URL=
# RPC for the browser (wallets). A public devnet URL, never one with a secret key.
VITE_SOLANA_RPC_URL=
# Devnet USDC mint. Circle devnet USDC: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# (the demo script creates its own test mint if this is empty)
USDC_MINT=
# Wallet that receives the MENA ROYAL share (public address)
MENAROYAL_TREASURY_WALLET=
# Signs certificate mints and transfers. Secret: base58 or [1,2,...] format.
MENAROYAL_AUTHORITY_SECRET_KEY=
MENAROYAL_AUTHORITY_PUBLIC_KEY=
# Optional: wallet that holds certificates for buyers without a wallet (future card payments)
MENAROYAL_CUSTODY_WALLET=
# Secret used to derive certificate addresses from serials. Long random text. Never change it once used.
CERT_SEED_SECRET=
# "inline" (default) or "irys" (Arweave via Irys devnet)
CERT_STORAGE=inline

# --- Helius (https://dashboard.helius.dev -> API keys) ---
HELIUS_API_KEY=
# Value Helius sends in the Authorization header of the webhook. Long random text.
HELIUS_WEBHOOK_SECRET=

# --- Site ---
# Public URL of the site, used in Solana Pay links (https in production)
PUBLIC_SITE_URL=
# Demo only: base URL for the phone QR (defaults to http://<laptop IP>:8080)
DEMO_BASE_URL=

# --- Existing payments ---
VITE_PAYPAL_CLIENT_ID=
# Card payments (Stripe, via the future UAE entity). Not used yet.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
